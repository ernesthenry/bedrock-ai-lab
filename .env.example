# Application Configuration
PAGE_TITLE=Knowledge Base Assistant
APP_TITLE=Knowledge Base Assistant

# AWS Bedrock Configuration
MODEL_ID=anthropic.claude-instant-v1
TEMPERATURE=0
TOP_K=10
MAX_TOKENS_TO_SAMPLE=750

# Retriever Configuration
# Options: "knowledge_base" or "kendra"
RETRIEVER_TYPE=knowledge_base

# Knowledge Base Configuration (if RETRIEVER_TYPE=knowledge_base)
KNOWLEDGE_BASE_ID=your-knowledge-base-id-here

# Kendra Configuration (if RETRIEVER_TYPE=kendra)
KENDRA_INDEX_ID=your-kendra-index-id-here

# Retrieval Configuration
TOP_K_RESULTS=4

# Chain Type Configuration
# Options: "conversational", "simple", or "agent"
CHAIN_TYPE=conversational

# PTO/Agent Configuration
# Set to "true" to enable PTO management features (required for agent chain type)
ENABLE_PTO=false
